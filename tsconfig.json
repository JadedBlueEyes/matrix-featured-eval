{
    "compilerOptions": {
        "target": "es2020",
        "module": "preserve",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "noImplicitAny": true,
        "allowJs": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "include": ["src/**/*.ts"]
}
